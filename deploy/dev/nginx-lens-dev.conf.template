# DEV site on the host nginx. Separate server block from prod (port 80).
# Installed by scripts/dev-env.sh up (placeholders filled in there).
server {
    listen __WEB_PORT__;
    server_name _;

    root __ROOT__/dist;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API on the same origin; the backend itself only listens on localhost.
    location /api/ {
        proxy_pass         http://127.0.0.1:__API_PORT__/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 2m;
    }
}
